# TWC Dashboard Configuration
# Copy this file to your Unraid appdata config folder as .env
# Path: /mnt/user/appdata/twc-dashboard/config/.env

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Timezone (find yours: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/Chicago

# Wall Connector(s) - format: name:ip,name:ip
# Example single charger: garage:192.168.1.100
# Example multiple: garage:192.168.1.100,driveway:192.168.1.101
TWC_CHARGERS=garage:192.168.1.100

# =============================================================================
# SECURITY - CHANGE THESE!
# =============================================================================

# InfluxDB admin credentials
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=changeme

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# InfluxDB API token (used internally)
INFLUXDB_ADMIN_TOKEN=twc-dashboard-token

# =============================================================================
# INFLUXDB SETTINGS
# =============================================================================

INFLUXDB_ORG=home
INFLUXDB_BUCKET=twc_dashboard

# =============================================================================
# POLLING INTERVALS (seconds)
# =============================================================================

# Wall Connector polling
TWC_POLL_VITALS_INTERVAL=5
TWC_POLL_LIFETIME_INTERVAL=60
TWC_POLL_VERSION_INTERVAL=300
TWC_POLL_WIFI_INTERVAL=60

# =============================================================================
# COMED HOURLY PRICING (Illinois)
# =============================================================================

COMED_ENABLED=true
COMED_POLL_INTERVAL=300
COMED_DELIVERY_PER_KWH=0.075

# =============================================================================
# TESSIE INTEGRATION (Optional)
# =============================================================================

TESSIE_ENABLED=false
TESSIE_POLL_INTERVAL=60
# FLEET_ENERGY_SITE_ID=        # Auto-discovered if empty
# FLEET_TWC_POLL_INTERVAL=30

# =============================================================================
# OPOWER / COMED METER DATA (Optional)
# =============================================================================
# To enable, run scripts/comed_opower_setup.py on your local PC
# Then copy .comed_opower_cache.json to this config folder
# The collector auto-detects the cache file within 30 seconds

OPOWER_ENABLED=false
OPOWER_POLL_INTERVAL=3600
OPOWER_TOKEN_REFRESH_INTERVAL=600
OPOWER_MFA_METHOD=email

# =============================================================================
# SMART CHARGING (Optional)
# =============================================================================

SMART_CHARGING_ENABLED=false
SMART_CHARGING_CONTROL_ENABLED=false
SMART_CHARGING_LOOKBACK_DAYS=30
SMART_CHARGING_STOP_PERCENTILE=90
SMART_CHARGING_RESUME_PERCENTILE=75
SMART_CHARGING_MIN_INTERVAL=600
